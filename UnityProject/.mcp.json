{
  "mcpServers": {
    "codedb-mcp": {
      "type": "stdio",
      "command": "cmd",
      "args": [
        "/c",
        ".codedb-mcp\\run-mcp.cmd"
      ]
    },
    "mempalace": {
      "type": "stdio",
      "command": "cmd",
      "args": [
        "/c",
        "tools\\mcp\\run-mempalace.cmd"
      ]
    },
    "puerts-unity-mcp": {
      "type": "stdio",
      "command": "node",
      "args": [
        "puerts-unity-mcp/Packages/puerts-unity-mcp/Tools~/puerts-unity-mcp-stdio-proxy.js",
        "--config",
        "puerts-unity-mcp-extension/editor-mcp-config.json"
      ]
    }
  }
}
